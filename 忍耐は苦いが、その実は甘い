pragma solidity ^0.8.20;

interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
}

contract PatienceVault {
    IERC20 public immutable token;
    address public owner;

    uint256 public dailyReward; // paid on every daily check-in
    uint256 public fruitBonus;  // extra paid when a streak completes
    uint256 public constant STREAK_NEEDED = 7;

    mapping(address => uint256) public streak;
    mapping(address => uint256) public lastCheckIn;
    mapping(address => uint256) public totalEarned;

    event CheckedIn(address indexed user, uint256 streak, uint256 paid);
    event FruitBonus(address indexed user, uint256 paid);

    constructor(address tokenAddress, uint256 _dailyReward, uint256 _fruitBonus) {
        token = IERC20(tokenAddress);
        owner = msg.sender;
        dailyReward = _dailyReward;
        fruitBonus = _fruitBonus;
    }

    function checkIn() external {
        uint256 today = block.timestamp / 1 days;
        uint256 lastDay = lastCheckIn[msg.sender] / 1 days;
        require(today > lastDay, "Already checked in today");

        if (today == lastDay + 1) {
            streak[msg.sender] += 1;
        } else {
            streak[msg.sender] = 1;
        }
        lastCheckIn[msg.sender] = block.timestamp;

        // The automatic part: the check-in calls the token.
        uint256 pay = dailyReward;
        if (streak[msg.sender] >= STREAK_NEEDED) {
            pay += fruitBonus;
            streak[msg.sender] = 0;
            emit FruitBonus(msg.sender, fruitBonus);
        }

        require(token.balanceOf(address(this)) >= pay, "Vault is empty - owner must refill");
        require(token.transfer(msg.sender, pay), "Token transfer failed");
        totalEarned[msg.sender] += pay;

        emit CheckedIn(msg.sender, streak[msg.sender], pay);
    }

    function withdraw() external {
        require(msg.sender == owner, "Not the owner");
        uint256 bal = token.balanceOf(address(this));
        require(token.transfer(owner, bal), "Token transfer failed");
    }
}